#!/bin/bash
# ppd-arm-sync: Sync CPU governor to power-profiles-daemon profile changes
# Maps: power-saver→powersave, balanced→schedutil, performance→performance

AVAILABLE="/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors"

set_governor() {
    local profile="$1"
    local governor

    case "$profile" in
        power-saver)  governor="powersave"   ;;
        balanced)     governor="schedutil"   ;;
        performance)  governor="performance" ;;
        *)            return ;;
    esac

    # Check if governor is available
    if ! grep -qw "$governor" "$AVAILABLE" 2>/dev/null; then
        echo "[ppd-arm-sync] governor '$governor' not available, skipping" >&2
        return 1
    fi

    # Apply to all CPUs
    for cpu_gov in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        echo "$governor" > "$cpu_gov" 2>/dev/null || true
    done

    echo "[ppd-arm-sync] profile=$profile → governor=$governor ✓"
}

# Apply immediately on start
current=$(busctl get-property org.freedesktop.UPower.PowerProfiles \
    /org/freedesktop/UPower/PowerProfiles \
    org.freedesktop.UPower.PowerProfiles ActiveProfile 2>/dev/null | sed 's/s "\(.*\)"/\1/')
[ -n "$current" ] && set_governor "$current"

# Watch D-Bus for profile changes
dbus-monitor --system "type='signal',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',path='/org/freedesktop/UPower/PowerProfiles'" 2>/dev/null | \
while IFS= read -r line; do
    case "$line" in
        *\"power-saver\"*)  set_governor "power-saver"   ;;
        *\"balanced\"*)     set_governor "balanced"      ;;
        *\"performance\"*)  set_governor "performance"   ;;
    esac
done
