#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        echo "ppd-arm-sync: Stopping and disabling service..."
        systemctl is-active --quiet ppd-governor-sync.service && systemctl stop ppd-governor-sync.service
        systemctl is-enabled --quiet ppd-governor-sync.service && systemctl disable ppd-governor-sync.service
        ;;
    upgrade)
        # During upgrade, just stop the service temporarily
        systemctl is-active --quiet ppd-governor-sync.service && systemctl stop ppd-governor-sync.service
        ;;
esac
